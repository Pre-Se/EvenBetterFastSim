<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      SecsGemBase ships from the public NuGet packages in the Release (and Debug) builds.
      Only the developer-only 'DebugLocal' config swaps in locally built SecsGemBase DLLs.
      These tests validate the shipping build, so they reference the app's *Release* output.

      The <Reference> glob below is expanded at evaluation time, so the app's Release
      output must already exist when this project builds. Run it as two steps:
           dotnet build EvenBetterFastSim/EvenBetterFastSim.csproj -c Release
           dotnet test  EvenBetterFastSim.Tests               -c Release
      (do NOT `dotnet build EvenBetterFastSim.sln` from clean — the test project would
       evaluate its reference glob before the app output exists.)
    -->
    <AppOut>$(MSBuildProjectDirectory)\..\EvenBetterFastSim\bin\Release\net10.0-windows7.0</AppOut>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- App + SecsGemBase + their NuGet deps, straight from the app's Release output. -->
  <ItemGroup>
    <Reference Include="$(AppOut)\*.dll" />
  </ItemGroup>

  <Target Name="EnsureAppIsBuilt" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AppOut)\EvenBetterFastSim.dll')"
           Text="App Release output not found at '$(AppOut)'. Build it first: dotnet build EvenBetterFastSim/EvenBetterFastSim.csproj -c Release" />
  </Target>

</Project>
