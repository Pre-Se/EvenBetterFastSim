<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      SecsGemBase ships from the public NuGet packages in the Release (and Debug) builds.
      Only the developer-only 'DebugLocal' config swaps in locally built SecsGemBase DLLs.
      These tests validate the shipping build, so they reference the app's *Release* output.

      The references are collected by the target 'EnsureAppIsBuilt' at the end of this file,
      at build time (not at evaluation time), so the app's Release output must exist before
      this project builds. Run it as two steps:
           dotnet build EvenBetterFastSim/EvenBetterFastSim.csproj -c Release
           dotnet test  EvenBetterFastSim.Tests               -c Release
      (do NOT `dotnet build EvenBetterFastSim.sln` from clean — the solution does not build
       the app before this project.)
      Never list the app's DLLs as single <Reference> items with absolute paths.
    -->
    <AppOut>$(MSBuildProjectDirectory)\..\EvenBetterFastSim\bin\Release\net10.0-windows7.0</AppOut>
  </PropertyGroup>

  <!--
    xUnit v3 through VSTest (the 'vstest' variant of the xunit3 template), so `dotnet test`, CI and the
    Visual Studio Test Explorer work as before. Keep 'xunit.v3.mtp-off': plain 'xunit.v3' brings Microsoft
    Testing Platform v2, and `dotnet test` on the .NET 10 SDK then fails in VSTest mode ("Testing with VSTest
    target is no longer supported by Microsoft.Testing.Platform") unless global.json opts into MTP.
    v3 runs the tests in their own process, started from the app host EvenBetterFastSim.Tests.exe: hence
    OutputType Exe above.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    App + SecsGemBase + their NuGet deps, straight from the app's Release output.
    The glob is inside the target on purpose: it is expanded when the target runs, right after
    the check, and Visual Studio cannot write it out as absolute paths into this file.
  -->
  <Target Name="EnsureAppIsBuilt" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AppOut)\EvenBetterFastSim.dll')" Text="App Release output not found at '$(AppOut)'. Build it first: dotnet build EvenBetterFastSim/EvenBetterFastSim.csproj -c Release" />
    <ItemGroup>
      <Reference Include="$(AppOut)/*.dll" />
    </ItemGroup>
  </Target>

</Project>
