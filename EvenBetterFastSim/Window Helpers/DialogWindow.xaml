<ui:FluentWindow x:Class="EvenBetterFastSim.Window_Helpers.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:windows="clr-namespace:EvenBetterFastSim.WPF.Windows"
        xmlns:viewModels="clr-namespace:EvenBetterFastSim.WPF.ViewModels"
        xmlns:responders="clr-namespace:EvenBetterFastSim.WPF.ViewModels.Responders"
        mc:Ignorable="d"
        Height="540" Width="600"
        MinWidth="400" MinHeight="300">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:SecsGemDataMessageViewModel}">
            <windows:SecsGemDataMessageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SetUpViewModel}">
            <windows:SetUpWindow />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InstanceProfileViewModel}">
            <windows:InstanceProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SecsGemItemViewModel}">
            <windows:SecsGemItemView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AddEventReportViewModel}">
            <windows:AddEventReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AddReportViewModel}">
            <windows:AddReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AddEquipmentVariableViewModel}">
            <windows:AddEquipmentVariableView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InspectSecsGemItemViewModel}">
            <windows:InspectSecsGemItemView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SecsGemTransactionViewModel}">
            <windows:SecsGemTransactionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type responders:NodeResponderViewModel}">
            <windows:NodeResponderView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding HeaderText}" />

        <ContentControl Grid.Row="1" Content="{Binding}" Margin="16,12,16,8" />

        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="OkButton" Content="OK" IsDefault="True"
                           Command="{Binding AcceptButtonClickCommand}"
                           Appearance="Primary"
                           Width="80" Margin="0,0,8,0" />
                <ui:Button Content="Cancel" IsCancel="True"
                           Appearance="Secondary"
                           Width="80" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
