<UserControl x:Class="EvenBetterFastSim.WPF.Windows.SecsGemDataMessageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:EvenBetterFastSim.WPF.ViewModels"
        xmlns:wpfControls="clr-namespace:EvenBetterFastSim.WPF.WPF_Controls"
        d:DataContext="{d:DesignInstance Type=viewModels:SecsGemDataMessageViewModel}"
        mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Stream" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,12,10" />
        <wpfControls:NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Margin="0,0,0,10"
                                   Minvalue="0" Maxvalue="127"
                                   NudValue="{Binding DataMessageCopy.Stream, Mode=TwoWay}" />

        <TextBlock Grid.Row="1" Grid.Column="2"
                   Text="Function" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="12,0,12,10" />
        <wpfControls:NumericUpDown Grid.Row="1" Grid.Column="3"
                                   Margin="0,0,0,10"
                                   Minvalue="0" Maxvalue="255"
                                   NudValue="{Binding DataMessageCopy.Function, Mode=TwoWay}" />

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Description" VerticalAlignment="Top"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,6,12,0" />
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                 TextWrapping="Wrap" MinHeight="80" AcceptsReturn="True"
                 Margin="0,0,0,10"
                 Text="{Binding DataMessageCopy.Description, Mode=TwoWay}" />

        <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                  Content="Reply"
                  Margin="0,0,0,8"
                  IsChecked="{Binding DataMessageCopy.Reply}" />

        <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                  Content="Is Primary"
                  IsChecked="{Binding DataMessageCopy.IsPrimary}" />
    </Grid>
</UserControl>
