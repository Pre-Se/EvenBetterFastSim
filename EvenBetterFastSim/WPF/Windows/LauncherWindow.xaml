<ui:FluentWindow x:Class="EvenBetterFastSim.WPF.Windows.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:viewModels="clr-namespace:EvenBetterFastSim.WPF.ViewModels"
        xmlns:services="clr-namespace:EvenBetterFastSim.Services"
        d:DataContext="{d:DesignInstance Type=viewModels:LauncherViewModel}"
        mc:Ignorable="d"
        Title="EvenBetterFastSim — Hub"
        Height="520" Width="620"
        MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterScreen">

    <DockPanel Background="{DynamicResource ApplicationBackgroundBrush}" LastChildFill="True">

        <ui:TitleBar DockPanel.Dock="Top" Title="EvenBetterFastSim — Hub" />

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="New" Command="{Binding NewProfileCommand}" Margin="0,0,8,0" />
                <ui:Button Content="New linked pair" Command="{Binding NewLinkedPairCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Edit" Command="{Binding EditProfileCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Duplicate" Command="{Binding DuplicateProfileCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Delete" Command="{Binding DeleteProfileCommand}" />
            </StackPanel>
        </Border>

        <!-- Launch bar -->
        <Border DockPanel.Dock="Bottom"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Padding="12,10">
            <ui:Button Content="Launch instance"
                       Appearance="Primary"
                       HorizontalAlignment="Right"
                       Padding="18,6"
                       Command="{Binding LaunchCommand}" />
        </Border>

        <!-- Profile list (fills remaining space) -->
        <Grid Margin="12">
            <ListBox ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding LaunchCommand}" />
                </ListBox.InputBindings>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <EventSetter Event="MouseDoubleClick" Handler="InstanceItem_MouseDoubleClick" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type services:InstanceProfile}">
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Endpoint}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="No instances yet — use “New” or “New linked pair”."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
