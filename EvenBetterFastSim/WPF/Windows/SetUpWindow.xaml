<UserControl
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:EvenBetterFastSim.WPF.ViewModels"
        xmlns:wpfControls="clr-namespace:EvenBetterFastSim.WPF.WPF_Controls"
        x:Class="EvenBetterFastSim.WPF.Windows.SetUpWindow"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance {x:Type viewModels:SetUpViewModel}}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SetupNavItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Margin="4,1,4,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" Grid.Column="0"
                                        Width="3" Height="16" CornerRadius="1.5"
                                        Background="Transparent" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <StackPanel Margin="0,8">
                <TextBlock Text="SETTINGS"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="16,4,8,6" />
                <RadioButton x:Name="NavTcpIp" GroupName="SetupNav" IsChecked="True"
                             Style="{StaticResource SetupNavItemStyle}">
                    <TextBlock Text="TCP / IP" VerticalAlignment="Center" />
                </RadioButton>
                <RadioButton x:Name="NavHsms" GroupName="SetupNav"
                             Style="{StaticResource SetupNavItemStyle}">
                    <TextBlock Text="HSMS" VerticalAlignment="Center" />
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Right content -->
        <Grid Grid.Column="1">

            <!-- TCP/IP Settings -->
            <Grid Margin="20,16"
                  Visibility="{Binding IsChecked, ElementName=NavTcpIp, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Text="TCP / IP Settings"
                           FontSize="15" FontWeight="SemiBold"
                           Margin="0,0,0,16" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="IP Address"
                           VerticalAlignment="Center" Margin="0,0,12,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                         Text="{Binding NetworkSettingsCopy.IpAddress, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Port"
                           VerticalAlignment="Center" Margin="0,0,12,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <wpfControls:NumericUpDown Grid.Row="2" Grid.Column="1"
                                          Margin="0,0,0,10" HorizontalAlignment="Left" Width="160"
                                          Minvalue="0" Maxvalue="65535"
                                          NudValue="{Binding NetworkSettingsCopy.Port, Mode=TwoWay}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Connection Mode"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox Grid.Row="3" Grid.Column="1"
                          HorizontalAlignment="Left" Width="200"
                          ItemsSource="{Binding ConnectionTypeValues}"
                          SelectedValue="{Binding NetworkSettingsCopy.ConnectionMode}" />
            </Grid>

            <!-- HSMS Parameters -->
            <Grid Margin="20,16"
                  Visibility="{Binding IsChecked, ElementName=NavHsms, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                           Text="HSMS Parameters"
                           FontSize="15" FontWeight="SemiBold"
                           Margin="0,0,0,16" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="T3 — Reply Timeout"
                           VerticalAlignment="Center" Margin="0,0,12,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <wpfControls:NumericUpDown Grid.Row="1" Grid.Column="1"
                                          Margin="0,0,0,10"
                                          Minvalue="1000" Maxvalue="120000"
                                          NudValue="{Binding HsmsParametersCopy.T3, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="ms"
                           VerticalAlignment="Center" Margin="8,0,0,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="T5 — Connection Separation Timeout"
                           VerticalAlignment="Center" Margin="0,0,12,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <wpfControls:NumericUpDown Grid.Row="2" Grid.Column="1"
                                          Margin="0,0,0,10"
                                          Minvalue="1000" Maxvalue="240000"
                                          NudValue="{Binding HsmsParametersCopy.T5, Mode=TwoWay}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="ms"
                           VerticalAlignment="Center" Margin="8,0,0,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="T6 — Control Transaction Timeout"
                           VerticalAlignment="Center" Margin="0,0,12,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <wpfControls:NumericUpDown Grid.Row="3" Grid.Column="1"
                                          Margin="0,0,0,10"
                                          Minvalue="1000" Maxvalue="240000"
                                          NudValue="{Binding HsmsParametersCopy.T6, Mode=TwoWay}" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="ms"
                           VerticalAlignment="Center" Margin="8,0,0,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="T7 — Not Selected Timeout"
                           VerticalAlignment="Center" Margin="0,0,12,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <wpfControls:NumericUpDown Grid.Row="4" Grid.Column="1"
                                          Margin="0,0,0,10"
                                          Minvalue="1000" Maxvalue="240000"
                                          NudValue="{Binding HsmsParametersCopy.T7, Mode=TwoWay}" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="ms"
                           VerticalAlignment="Center" Margin="8,0,0,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="T8 — Network Inter-character Timeout"
                           VerticalAlignment="Center" Margin="0,0,12,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <wpfControls:NumericUpDown Grid.Row="5" Grid.Column="1"
                                          Margin="0,0,0,10"
                                          Minvalue="1000" Maxvalue="120000"
                                          NudValue="{Binding HsmsParametersCopy.T8, Mode=TwoWay}" />
                <TextBlock Grid.Row="5" Grid.Column="2" Text="ms"
                           VerticalAlignment="Center" Margin="8,0,0,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Session ID"
                           VerticalAlignment="Center" Margin="0,0,12,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <wpfControls:NumericUpDown Grid.Row="6" Grid.Column="1"
                                          Margin="0,0,0,10"
                                          Minvalue="0" Maxvalue="65535"
                                          NudValue="{Binding HsmsParametersCopy.SessionId, Mode=TwoWay}" />

                <CheckBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                          Content="Ignore HSMS State"
                          Margin="0,0,0,8"
                          IsChecked="{Binding HsmsParametersCopy.IgnoreState}" />
                <CheckBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
                          Content="Initiate Select Request"
                          Margin="0,0,0,8"
                          IsChecked="{Binding HsmsParametersCopy.InitiateSelectRequest}" />
                <CheckBox Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3"
                          Content="Control Message Compatibility Mode"
                          IsChecked="{Binding HsmsParametersCopy.ControlMessageSessionIdCompatibility}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
