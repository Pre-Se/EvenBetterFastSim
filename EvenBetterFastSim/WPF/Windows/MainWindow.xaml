<ui:FluentWindow x:Class="EvenBetterFastSim.WPF.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:behaviors="clr-namespace:EvenBetterFastSim.Helpers"
        xmlns:log="clr-namespace:EvenBetterFastSim.Logging"
        xmlns:m1="clr-namespace:SecsGemBaseItems.Data_Containers;assembly=SecsGemBaseItems"
        xmlns:logging="clr-namespace:Logging;assembly=Logging"
        xmlns:viewModels="clr-namespace:EvenBetterFastSim.WPF.ViewModels"
        xmlns:models="clr-namespace:EvenBetterFastSim.WPF.ViewModels.Models"
        xmlns:graph="clr-namespace:EvenBetterFastSim.WPF.ViewModels.Graph"
        xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
        xmlns:enums="clr-namespace:Logging.Enums;assembly=Logging"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
        mc:Ignorable="d"
        Name="MainWin"
        Title="{Binding WindowTitle}"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="900">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <behaviors:MessageHeaderConverter x:Key="MsgHeaderConverter" />

        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Margin="4,1,4,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" Grid.Column="0"
                                        Width="3" Height="16" CornerRadius="1.5"
                                        Background="Transparent" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="16,14,8,4" />
        </Style>

        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>

        <Style x:Key="StatusValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>

        <Style x:Key="ToolbarBorderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="ui:Button"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Title bar -->
            <RowDefinition Height="Auto" />   <!-- Menu -->
            <RowDefinition Height="*" />      <!-- Main content -->
            <RowDefinition Height="5" />      <!-- Splitter -->
            <RowDefinition Height="180" />    <!-- System log -->
            <RowDefinition Height="Auto" />   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Title bar (provides drag + Win11 window buttons) -->
        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}" />

        <!-- Menu bar -->
        <Border Grid.Row="1"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Menu Padding="6,2" Background="Transparent">
                <MenuItem Header="_Library">
                    <MenuItem Header="_Open Library" Command="{Binding OpenLibraryCommand}" />
                    <MenuItem Header="_Save Library" Command="{Binding SaveLibraryCommand}" />
                    <Separator />
                    <MenuItem Header="_Save Events" Command="{Binding SaveEventsCommand}" />
                    <MenuItem Header="_Load Events" Command="{Binding LoadEventsCommand}" />
                </MenuItem>
                <MenuItem Header="_Connection">
                    <MenuItem Header="_Properties" Command="{Binding OpenSetUpWindowCommand}" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- Main content: left nav + section content + message log -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />    <!-- Nav sidebar -->
                <ColumnDefinition Width="2*" />     <!-- Section content -->
                <ColumnDefinition Width="Auto" />   <!-- Splitter -->
                <ColumnDefinition Width="3*" />     <!-- Message log -->
            </Grid.ColumnDefinitions>

            <!-- Left navigation sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="LIBRARY" Style="{StaticResource NavSectionLabelStyle}" />

                    <RadioButton x:Name="NavMessages" GroupName="NavGroup" IsChecked="True"
                                 Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Document20" Margin="0,0,10,0" />
                            <TextBlock Text="Messages" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavEvents" GroupName="NavGroup"
                                 Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Flash20" Margin="0,0,10,0" />
                            <TextBlock Text="Events" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavReports" GroupName="NavGroup"
                                 Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ClipboardTextLtr20" Margin="0,0,10,0" />
                            <TextBlock Text="Reports" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavVariables" GroupName="NavGroup"
                                 Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Database20" Margin="0,0,10,0" />
                            <TextBlock Text="Variables" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavScenarios" GroupName="NavGroup"
                                 Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Flow20" Margin="0,0,10,0" />
                            <TextBlock Text="Scenarios" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Section content — all 4 stacked, visibility driven by nav selection -->
            <Grid Grid.Column="1">

                <!-- Messages -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavMessages, Converter={StaticResource BoolToVis}}">
                    <Grid.InputBindings>
                        <KeyBinding Key="A" Command="{Binding AddItemCommand}" />
                        <KeyBinding Key="S" Command="{Binding SendTransactionCommand}" />
                        <KeyBinding Key="D" Command="{Binding DuplicateSelectedItemCommand}" />
                        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding MoveSelectedItemUpCommand}" />
                        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding MoveSelectedItemDownCommand}" />
                    </Grid.InputBindings>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource ToolbarBorderStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Messages"
                                       Style="{StaticResource PanelHeaderStyle}" Margin="0,0,16,0" />
                            <WrapPanel>
                                <ui:Button Content="Modify" Command="{Binding ModifySelectedItemCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Add Transaction" Command="{Binding AddTransactionCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Add Item" Command="{Binding AddItemCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Duplicate" Command="{Binding DuplicateSelectedItemCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Delete" Command="{Binding DeleteSelectedItemCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Up" Command="{Binding MoveSelectedItemUpCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Down" Command="{Binding MoveSelectedItemDownCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,8,0" />
                                <ui:Button Content="Send" Command="{Binding SendTransactionCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Primary" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                    <TreeView Grid.Row="1" Name="MessageLibraryTreeView" IsTextSearchEnabled="False"
                              ItemsSource="{Binding SecsGemMessageLibrary}"
                              behaviors:EventToCommandAdaptor.TreeViewSelectedItemChangedCommand="{Binding SelectedItemChangedCommand}"
                              behaviors:EventToCommandAdaptor.TreeViewSelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type m1:SecsGemItem}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.ModifySelectedItemCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                    </StackPanel.InputBindings>
                                    <TextBlock Text="{Binding Header}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type m1:SecsGemDataMessage}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.ModifySelectedItemCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                    </StackPanel.InputBindings>
                                    <TextBlock Text="{Binding Header}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type m1:SecsGemTransaction}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.ModifySelectedItemCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                    </StackPanel.InputBindings>
                                    <TextBlock Text="{Binding Header}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>

                <!-- Events -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavEvents, Converter={StaticResource BoolToVis}}">
                    <Grid.InputBindings>
                        <KeyBinding Key="A" Command="{Binding AddEventCommand}" />
                        <KeyBinding Key="S" Command="{Binding SendEventCommand}" />
                    </Grid.InputBindings>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="220" MinWidth="120" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource ToolbarBorderStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Events"
                                       Style="{StaticResource PanelHeaderStyle}" Margin="0,0,16,0" />
                            <WrapPanel>
                                <ui:Button Content="Modify" Command="{Binding ModifyEventCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Add Event" Command="{Binding AddEventCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Delete" Command="{Binding DeleteEventCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,8,0" />
                                <ui:Button Content="Send Event" Command="{Binding SendEventCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Primary" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Row="1" Grid.Column="1"
                                  Width="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <TreeView Grid.Row="1" Grid.Column="0" Name="EventCollectionTreeView" IsTextSearchEnabled="False"
                              ItemsSource="{Binding SecsGemEventCollection}"
                              behaviors:EventToCommandAdaptor.TreeViewSelectedItemChangedCommand="{Binding SelectedEventChangedCommand}"
                              behaviors:EventToCommandAdaptor.TreeViewSelectedItem="{Binding EventLibraryManager.SelectedEvent, Mode=TwoWay}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:EventReportViewModel}" ItemsSource="{Binding ReportList}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Header}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                    <Border Grid.Row="1" Grid.Column="2"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0">
                        <Grid Margin="10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="LINKED REPORTS"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,8" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LinkableReports}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Header}"
                                                      IsChecked="{Binding IsLinked}"
                                                      Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Reports -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavReports, Converter={StaticResource BoolToVis}}">
                    <Grid.InputBindings>
                        <KeyBinding Key="A" Command="{Binding AddReportCommand}" />
                    </Grid.InputBindings>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="220" MinWidth="120" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource ToolbarBorderStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Reports"
                                       Style="{StaticResource PanelHeaderStyle}" Margin="0,0,16,0" />
                            <WrapPanel>
                                <ui:Button Content="Modify" Command="{Binding ModifyReportCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Add Report" Command="{Binding AddReportCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Delete" Command="{Binding DeleteReportCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Row="1" Grid.Column="1"
                                  Width="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <TreeView Grid.Row="1" Grid.Column="0" Name="ReportCollectionTreeView" IsTextSearchEnabled="False"
                              ItemsSource="{Binding SecsGemReportCollection}"
                              behaviors:EventToCommandAdaptor.TreeViewSelectedItemChangedCommand="{Binding SelectedReportChangedCommand}"
                              behaviors:EventToCommandAdaptor.TreeViewSelectedItem="{Binding EventLibraryManager.SelectedReport, Mode=TwoWay}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:ReportViewModel}" ItemsSource="{Binding VariableList}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Header}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                    <Border Grid.Row="1" Grid.Column="2"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0">
                        <Grid Margin="10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="LINKED VARIABLES"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,8" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LinkableVariables}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Header}"
                                                      IsChecked="{Binding IsLinked}"
                                                      Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Variables -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavVariables, Converter={StaticResource BoolToVis}}">
                    <Grid.InputBindings>
                        <KeyBinding Key="A" Command="{Binding AddVariableCommand}" />
                    </Grid.InputBindings>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource ToolbarBorderStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Variables"
                                       Style="{StaticResource PanelHeaderStyle}" Margin="0,0,16,0" />
                            <WrapPanel>
                                <ui:Button Content="Modify" Command="{Binding ModifyVariableCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Add Variable" Command="{Binding AddVariableCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Delete" Command="{Binding DeleteVariableCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                    <TreeView Grid.Row="1" Name="VariableCollectionTreeView" IsTextSearchEnabled="False"
                              ItemsSource="{Binding SecsGemVariableCollection}"
                              behaviors:EventToCommandAdaptor.TreeViewSelectedItemChangedCommand="{Binding SelectedVariableChangedCommand}"
                              behaviors:EventToCommandAdaptor.TreeViewSelectedItem="{Binding EventLibraryManager.SelectedVariable, Mode=TwoWay}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:VariableViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Header}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>

                <!-- Scenarios -->
                <Grid Visibility="{Binding IsChecked, ElementName=NavScenarios, Converter={StaticResource BoolToVis}}"
                      DataContext="{Binding ScenariosVm}">
                    <Grid.InputBindings>
                        <KeyBinding Key="F5" Command="{Binding RunScenarioCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CancelRunCommand}" />
                        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveScenariosCommand}" />
                    </Grid.InputBindings>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="160" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="200" MinWidth="140" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Scenarios toolbar -->
                    <Border Grid.Row="0" Grid.ColumnSpan="5" Style="{StaticResource ToolbarBorderStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Scenarios"
                                       Style="{StaticResource PanelHeaderStyle}" Margin="0,0,16,0" />
                            <WrapPanel>
                                <ui:Button Content="New" Command="{Binding NewScenarioCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Delete" Command="{Binding DeleteScenarioCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Rename" Command="{Binding RenameScenarioCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Reload" Command="{Binding LoadScenariosCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Save" Command="{Binding SaveScenariosCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Save As" Command="{Binding ExportScenarioCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,4,0" />
                                <ui:Button Content="Open" Command="{Binding ImportScenarioCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,8,0" />
                                <ui:Button Content="Run" Command="{Binding RunScenarioCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Primary" Margin="0,0,4,0" />
                                <ui:Button Content="Cancel" Command="{Binding CancelRunCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}" Appearance="Secondary" Margin="0,0,10,0" />
                                <TextBlock Text="Timeout (s)" VerticalAlignment="Center" Margin="0,0,4,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBox Width="52" VerticalAlignment="Center" Margin="0,0,10,0"
                                         Text="{Binding RunTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Max seconds per run (0 = wait forever — Receive nodes block until their message arrives or you hit Cancel). Also bounds each loop iteration." />
                                <TextBlock Text="Retry (s)" VerticalAlignment="Center" Margin="0,0,4,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBox Width="52" VerticalAlignment="Center"
                                         Text="{Binding RunRetrySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Delay between loop iterations (0 = a brief 200 ms pause). Only applies while a scenario is looping." />
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <!-- Scenario list -->
                    <Border Grid.Row="1" Grid.Column="0"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderThickness="0,0,0,0">
                        <Grid Margin="8,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="SCENARIOS"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,8" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding Scenarios}"
                                     SelectedItem="{Binding SelectedScenario}"
                                     HorizontalContentAlignment="Stretch"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ToggleButton Grid.Column="1" Content="⟳"
                                                          Width="22" Height="20" Padding="0" FontSize="12"
                                                          VerticalAlignment="Center"
                                                          ToolTip="Loop this scenario (restart from Start after each finish)"
                                                          IsChecked="{Binding IsLooping, Mode=OneWay}"
                                                          Command="{Binding DataContext.ToggleScenarioLoopCommand,
                                                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                          CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="1" Grid.Column="1"
                                  Width="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <!-- Canvas -->
                    <Grid Grid.Row="1" Grid.Column="2" ClipToBounds="True">
                        <nodify:NodifyEditor x:Name="ScenarioCanvas"
                                             ItemsSource="{Binding Nodes}"
                                             Connections="{Binding Connections}"
                                             SelectedItems="{Binding SelectedNodes}"
                                             SelectedConnections="{Binding SelectedConnections}"
                                             PendingConnection="{Binding PendingConnection}"
                                             Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                             AllowDrop="True"
                                             DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                                             RemoveConnectionCommand="{Binding DeleteConnectionCommand}"
                                              PreviewDrop="ScenarioCanvas_PreviewDrop"
                                              PreviewDragOver="ScenarioCanvas_PreviewDragOver">
                             <nodify:NodifyEditor.InputBindings>
                                 <KeyBinding Key="Delete" Command="{Binding DeleteSelectionCommand}" />
                                 <KeyBinding Key="Return" Command="{Binding EditSelectedNodeCommand}" />
                             </nodify:NodifyEditor.InputBindings>
                             <nodify:NodifyEditor.ItemContainerStyle>
                                 <Style TargetType="nodify:ItemContainer" BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
                                     <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                                     <Setter Property="IsSelected" Value="{Binding IsSelected}" />
                                 </Style>
                             </nodify:NodifyEditor.ItemContainerStyle>
                            <nodify:NodifyEditor.ItemTemplate>
                                <DataTemplate DataType="{x:Type graph:ScenarioNodeViewModel}">
                                  <Grid>
                                    <nodify:Node Header="{Binding Title}"
                                                 Input="{Binding Input}"
                                                 Output="{Binding Output}"
                                                 MinWidth="110">
                                        <nodify:Node.Style>
                                            <Style TargetType="nodify:Node" BasedOn="{StaticResource {x:Type nodify:Node}}">
                                                <!-- Colour-code by role so a chain reads at a glance. -->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReceiveNode}" Value="True">
                                                        <Setter Property="HeaderBrush" Value="#1F6FEB" />
                                                        <Setter Property="BorderBrush" Value="#1F6FEB" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSendNode}" Value="True">
                                                        <Setter Property="HeaderBrush" Value="#2EA043" />
                                                        <Setter Property="BorderBrush" Value="#2EA043" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Start">
                                                        <Setter Property="HeaderBrush" Value="#6E7681" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="End">
                                                        <Setter Property="HeaderBrush" Value="#6E7681" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="And">
                                                        <Setter Property="HeaderBrush" Value="#8957E5" />
                                                        <Setter Property="BorderBrush" Value="#8957E5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </nodify:Node.Style>
                                        <nodify:Node.Content>
                                            <StackPanel HorizontalAlignment="Center">
                                                <Button Command="{Binding ToggleSendModeCommand}"
                                                        Visibility="{Binding CanToggleMode, Converter={StaticResource BoolToVis}}"
                                                        Content="{Binding SendModeLabel}"
                                                        FontSize="9"
                                                        Padding="4,2"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding ConditionSummary}" FontSize="9" Margin="0,3,0,0"
                                                           HorizontalAlignment="Center" TextAlignment="Center"
                                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ConditionSummary}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding BindingSummary}" FontSize="9" Margin="0,2,0,0"
                                                           HorizontalAlignment="Center" TextAlignment="Center"
                                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BindingSummary}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </nodify:Node.Content>
                                        <nodify:Node.InputConnectorTemplate>
                                            <DataTemplate DataType="{x:Type graph:ConnectorViewModel}">
                                                <nodify:NodeInput IsConnected="{Binding IsConnected}"
                                                                  Anchor="{Binding Anchor, Mode=OneWayToSource}">
                                                    <nodify:NodeInput.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Disconnect"
                                                                      Command="{Binding Source={x:Reference MainWin},
                                                                          Path=DataContext.ScenariosVm.DisconnectConnectorCommand}"
                                                                      CommandParameter="{Binding}" />
                                                        </ContextMenu>
                                                    </nodify:NodeInput.ContextMenu>
                                                </nodify:NodeInput>
                                            </DataTemplate>
                                        </nodify:Node.InputConnectorTemplate>
                                        <nodify:Node.OutputConnectorTemplate>
                                            <DataTemplate DataType="{x:Type graph:ConnectorViewModel}">
                                                <nodify:NodeOutput IsConnected="{Binding IsConnected}"
                                                                   Anchor="{Binding Anchor, Mode=OneWayToSource}">
                                                    <nodify:NodeOutput.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Disconnect"
                                                                      Command="{Binding Source={x:Reference MainWin},
                                                                          Path=DataContext.ScenariosVm.DisconnectConnectorCommand}"
                                                                      CommandParameter="{Binding}" />
                                                        </ContextMenu>
                                                    </nodify:NodeOutput.ContextMenu>
                                                </nodify:NodeOutput>
                                            </DataTemplate>
                                        </nodify:Node.OutputConnectorTemplate>
                                    </nodify:Node>

                                    <!-- Run-status icon, top-left over the header. No text (detail on hover). -->
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7,3,0,0"
                                               FontSize="11" Panel.ZIndex="10" ToolTip="{Binding RunDetail}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Text" Value="&#x23F3;&#xFE0E;" />
                                                <Setter Property="Foreground" Value="#FFD666" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RunState}" Value="Waiting">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RunState}" Value="Failed">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Text" Value="&#x26A0;&#xFE0E;" />
                                                        <Setter Property="Foreground" Value="#FF6B6B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                  </Grid>
                                </DataTemplate>
                            </nodify:NodifyEditor.ItemTemplate>
                            <nodify:NodifyEditor.ConnectionTemplate>
                                <DataTemplate DataType="{x:Type graph:ConnectionViewModel}">
                                    <nodify:LineConnection Source="{Binding Source.Anchor}"
                                                           Target="{Binding Target.Anchor}"
                                                           nodify:BaseConnection.IsSelectable="True"
                                                           nodify:BaseConnection.IsSelected="{Binding IsSelected}">
                                        <nodify:LineConnection.Style>
                                            <Style TargetType="nodify:LineConnection" BasedOn="{StaticResource {x:Type nodify:LineConnection}}">
                                                <Style.Triggers>
                                                    <Trigger Property="nodify:BaseConnection.IsSelected" Value="True">
                                                        <Setter Property="Stroke" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                        <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect ShadowDepth="0"
                                                                                  BlurRadius="14"
                                                                                  Opacity="0.85" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </nodify:LineConnection.Style>
                                        <nodify:LineConnection.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Delete"
                                                          Command="{Binding Source={x:Reference MainWin},
                                                              Path=DataContext.ScenariosVm.DeleteConnectionCommand}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </nodify:LineConnection.ContextMenu>
                                    </nodify:LineConnection>
                                </DataTemplate>
                            </nodify:NodifyEditor.ConnectionTemplate>
                            <nodify:NodifyEditor.PendingConnectionTemplate>
                                <DataTemplate DataType="{x:Type graph:PendingConnectionViewModel}">
                                    <nodify:PendingConnection StartedCommand="{Binding StartCommand}"
                                                              CompletedCommand="{Binding FinishCommand}"
                                                              AllowOnlyConnectors="True" />
                                </DataTemplate>
                            </nodify:NodifyEditor.PendingConnectionTemplate>
                        </nodify:NodifyEditor>
                    </Grid>

                    <GridSplitter Grid.Row="1" Grid.Column="3"
                                  Width="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <!-- Transaction library panel -->
                    <Border Grid.Row="1" Grid.Column="4"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderThickness="0">
                        <Grid Margin="8,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="NODES"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,6" />
                            <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                                <Border Tag="And"
                                        MouseLeftButtonDown="NodePaletteChip_MouseLeftButtonDown"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="#8957E5" BorderThickness="1"
                                        CornerRadius="4" Padding="10,4" Cursor="Hand"
                                        ToolTip="Join: continues only when every incoming connection has arrived">
                                    <TextBlock Text="AND" FontWeight="SemiBold" />
                                </Border>
                            </WrapPanel>

                            <TextBlock Grid.Row="2" Text="DRAG TO CANVAS"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,8" />
                            <TreeView Grid.Row="3" Name="TransactionLibraryTree"
                                      ItemsSource="{Binding AvailableTransactions}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <EventSetter Event="PreviewMouseMove" Handler="TransactionTree_PreviewMouseMove" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type m1:SecsGemTransaction}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text=" - " />
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type m1:SecsGemDataMessage}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Header}" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type m1:SecsGemItem}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Header}" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>

            <!-- Vertical splitter -->
            <GridSplitter Grid.Column="2"
                          Width="4" VerticalAlignment="Stretch" HorizontalAlignment="Center"
                          Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!-- Message log -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource ToolbarBorderStyle}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Clear"
                                   Command="{Binding ClearMessageLogCommand}"
                                   Appearance="Secondary" Padding="10,4" />
                        <TextBlock Text="Message Log" Style="{StaticResource PanelHeaderStyle}" />
                    </DockPanel>
                </Border>
                <TreeView Grid.Row="1" ItemsSource="{Binding SecsGemMessagesLog}">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type m1:SecsGemItem}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.InspectLoggedItemCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                  CommandParameter="{Binding}" />
                                </StackPanel.InputBindings>
                                <TextBlock Text="{Binding Header}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type logging:LoggedControlMessage}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="CtrlMsgIcon" Symbol="ArrowCircleUp20"
                                               Foreground="#00CC44" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding TimeStamp, StringFormat={}{0:HH:mm:ss.fff}}"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Header, Converter={StaticResource MsgHeaderConverter}}" />
                            </StackPanel>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Result}" Value="{x:Static enums:MessageResult.Received}">
                                    <Setter TargetName="CtrlMsgIcon" Property="Symbol" Value="ArrowCircleDown20" />
                                    <Setter TargetName="CtrlMsgIcon" Property="Foreground" Value="#0088FF" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type logging:LoggedDataMessage}" ItemsSource="{Binding Data.Children}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="MsgIcon" Symbol="ArrowCircleUp20"
                                               Foreground="#00CC44" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding TimeStamp, StringFormat={}{0:HH:mm:ss.fff}}"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Data.Header}" />
                            </StackPanel>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Result}" Value="{x:Static enums:MessageResult.Received}">
                                    <Setter TargetName="MsgIcon" Property="Symbol" Value="ArrowCircleDown20" />
                                    <Setter TargetName="MsgIcon" Property="Foreground" Value="#0088FF" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Grid>
        </Grid>

        <!-- Horizontal splitter between main and log -->
        <GridSplitter Grid.Row="3"
                      Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows"
                      Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <!-- System log -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource ToolbarBorderStyle}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Clear"
                               Command="{Binding ClearLogCommand}"
                               Appearance="Secondary" Padding="10,4" />
                    <TextBlock Text="System Log" Style="{StaticResource PanelHeaderStyle}" />
                </DockPanel>
            </Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding LoggedStringCollection}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,1" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type log:LoggedString}">
                        <TextBlock Text="{Binding}" Foreground="{Binding TextColor}"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="11" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="5"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Connection status (left) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="{Binding ConnectionValues.ActionText}"
                               Command="{Binding ConnectCommand}"
                               Appearance="Secondary" Padding="14,5" Margin="0,0,14,0" />

                    <Border Background="{Binding ConnectionValues.BackgroundColor}"
                            CornerRadius="4" Padding="9,3" Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectionValues.Text}"
                                   FontSize="12" FontWeight="SemiBold" />
                    </Border>

                    <TextBlock Text="HSMS" Style="{StaticResource StatusLabelStyle}" />
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusValueStyle}">
                                <Setter Property="Text" Value="{Binding ControlMessageHandling.HSMSStatus}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ControlMessageHandling.HSMSStatus}" Value="NotConnected">
                                        <Setter Property="Text" Value="Not Connected" />
                                        <Setter Property="Foreground" Value="DarkRed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ControlMessageHandling.HSMSStatus}" Value="NotSelected">
                                        <Setter Property="Text" Value="Not Selected" />
                                        <Setter Property="Foreground" Value="Orange" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ControlMessageHandling.HSMSStatus}" Value="Selected">
                                        <Setter Property="Text" Value="Selected" />
                                        <Setter Property="Foreground" Value="Green" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ControlMessageHandling.HSMSStatus}" Value="CommunicationFailure">
                                        <Setter Property="Text" Value="Comm Failure" />
                                        <Setter Property="Foreground" Value="Red" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Comms" Style="{StaticResource StatusLabelStyle}" />
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusValueStyle}">
                                <Setter Property="Text" Value="Not Established" />
                                <Setter Property="Foreground" Value="Red" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataMessageHandler.CommunicationsEstablished}" Value="True">
                                        <Setter Property="Text" Value="Established" />
                                        <Setter Property="Foreground" Value="Green" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="State" Style="{StaticResource StatusLabelStyle}" />
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusValueStyle}">
                                <Setter Property="Text" Value="{Binding ControlStateInfo.ControlSubstate}" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ControlStateInfo.ControlSubstate}" Value="EquipmentOffline">
                                        <Setter Property="Text" Value="Equipment Offline" />
                                        <Setter Property="Foreground" Value="DarkRed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ControlStateInfo.ControlSubstate}" Value="AttemptOnline">
                                        <Setter Property="Text" Value="Attempt Online" />
                                        <Setter Property="Foreground" Value="OrangeRed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ControlStateInfo.ControlSubstate}" Value="HostOffline">
                                        <Setter Property="Text" Value="Host Offline" />
                                        <Setter Property="Foreground" Value="DarkSeaGreen" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ControlStateInfo.ControlSubstate}" Value="OnlineLocal">
                                        <Setter Property="Text" Value="Online (Local)" />
                                        <Setter Property="Foreground" Value="YellowGreen" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ControlStateInfo.ControlSubstate}" Value="OnlineRemote">
                                        <Setter Property="Text" Value="Online (Remote)" />
                                        <Setter Property="Foreground" Value="Green" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Control state buttons (right) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Auto-online on connect"
                              IsChecked="{Binding AutoStartOnline}"
                              VerticalAlignment="Center" Margin="0,0,12,0"
                              ToolTip="Automatically request ON-LINE once communications are established after connecting" />
                    <ui:Button Content="Online" Command="{Binding TurnOnlineCommand}"
                               Appearance="Secondary" Margin="0,0,4,0" />
                    <ui:Button Content="Offline" Command="{Binding TurnOfflineCommand}"
                               Appearance="Secondary" Margin="0,0,4,0" />
                    <ui:Button Content="{Binding OnlineModeLabel}" Command="{Binding ToggleOnlineModeCommand}"
                               Appearance="Secondary"
                               ToolTip="Toggle online substate: Local ↔ Remote" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
