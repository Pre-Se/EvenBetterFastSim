<UserControl
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:EvenBetterFastSim.WPF.ViewModels"
        xmlns:wpfControls="clr-namespace:EvenBetterFastSim.WPF.WPF_Controls"
        x:Class="EvenBetterFastSim.WPF.Windows.InstanceProfileView"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance {x:Type viewModels:InstanceProfileViewModel}}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="{Binding Title}"
                   FontSize="15" FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding NameLabel}"
                   VerticalAlignment="Center" Margin="0,0,12,10"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="IP Address"
                   VerticalAlignment="Center" Margin="0,0,12,10"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Port"
                   VerticalAlignment="Center" Margin="0,0,12,10"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <wpfControls:NumericUpDown Grid.Row="3" Grid.Column="1"
                                  Margin="0,0,0,10" HorizontalAlignment="Left" Width="160"
                                  Minvalue="0" Maxvalue="65535"
                                  NudValue="{Binding Port, Mode=TwoWay}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Connection Mode"
                   VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding ShowConnectionMode, Converter={StaticResource BoolToVis}}" />
        <ComboBox Grid.Row="4" Grid.Column="1"
                  HorizontalAlignment="Left" Width="200"
                  ItemsSource="{Binding ConnectionModeValues}"
                  SelectedValue="{Binding ConnectionMode}"
                  Visibility="{Binding ShowConnectionMode, Converter={StaticResource BoolToVis}}" />

        <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                  Margin="0,14,0,0"
                  Content="{Binding LaunchAfterCreateLabel}"
                  IsChecked="{Binding LaunchAfterCreate, Mode=TwoWay}"
                  Visibility="{Binding ShowLaunchAfterCreate, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
