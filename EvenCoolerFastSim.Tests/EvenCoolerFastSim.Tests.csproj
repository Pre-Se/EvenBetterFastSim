<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      The app uses a custom 'DebugLocal' configuration that references the locally
      built SecsGemBase DLLs (which contain the SecsGemValueItem<T> generics).
      Rather than re-implement that conditional reference logic, this test project
      references whatever the app shipped to its DebugLocal output folder.

      => Build the app once before running the tests:
           dotnet build EvenBetterFastSim.sln -c DebugLocal
           dotnet test EvenBetterFastSim.Tests
    -->
    <AppOut>$(MSBuildProjectDirectory)\..\EvenBetterFastSim\bin\DebugLocal\net10.0-windows7.0</AppOut>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- App + SecsGemBase + their NuGet deps, straight from the app's build output. -->
  <ItemGroup>
    <Reference Include="$(AppOut)\*.dll" />
  </ItemGroup>

  <Target Name="EnsureAppIsBuilt" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AppOut)\EvenBetterFastSim.dll')"
           Text="App output not found at '$(AppOut)'. Build it first: dotnet build EvenBetterFastSim.sln -c DebugLocal" />
  </Target>

</Project>
